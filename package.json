{
  "name": "dsh-wallpaper",
  "version": "0.1.3",
  "description": "为 DSH Desktop 设置自定义背景图（壁纸）。Sets a custom background image (wallpaper) for DSH Desktop.",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "wallpaper",
    "background",
    "desktop"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
